<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
  </startup>

  <!--
    Windows Forms only honours the manifest's Per-Monitor-V2 declaration when
    these switches are on as well; without them the framework keeps its legacy
    system-DPI behaviour and the window blurs on a scaled display.
  -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
    <add key="DisableDpiChangedMessageHandling" value="false" />
    <add key="CheckForOverflowUnderflow" value="false" />
  </System.Windows.Forms.ApplicationConfigurationSection>

  <runtime>
    <!-- Lets file APIs address paths beyond MAX_PATH, matching the manifest. -->
    <AppContextSwitchOverrides value="Switch.System.IO.UseLegacyPathHandling=false;Switch.System.IO.BlockLongPaths=false" />
  </runtime>
</configuration>
