#include <windows.h>

// The application, carried whole. Written next to this file by the build
// before the resource compiler runs.
APPBIN      RCDATA                  "ConfigurO.exe"

// Elevation and OS declarations.
1           RT_MANIFEST             "bootstrap.manifest"

// The setup program wears the application's icon.
1           ICON                    "ConfigurO.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "WRSTT"
            VALUE "FileDescription",  "ConfigurO Setup"
            VALUE "ProductName",      "ConfigurO"
            VALUE "LegalCopyright",   "Copyright (C) WRSTT"
            VALUE "OriginalFilename", "ConfigurO-Setup.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
